# Required
OPENAI_API_KEY=sk-...

# The lead designs the system; a stronger model here pays for itself, because
# every other agent works from its design.
LEAD_MODEL=openai/gpt-4o
ENGINEER_MODEL=openai/gpt-4o-mini

# The image the agents' code runs inside. Anything with uv and Python works.
SANDBOX_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Seconds before a runaway script in the sandbox is killed
SANDBOX_TIMEOUT=300
